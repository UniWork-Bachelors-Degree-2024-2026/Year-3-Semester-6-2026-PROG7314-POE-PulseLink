<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- PulseLink: Remote Patient Monitoring System Web API (.NET 10) -->
    <RootNamespace>PulseLinkAPI</RootNamespace>
    <AssemblyName>PulseLinkAPI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- OpenAPI documentation and Scalar interactive API explorer (Microsoft, 2024) -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.2" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.0.18" />  <!-- (Scalar, 2025) -->

    <!-- Google Firebase Admin SDK for server-side auth & Realtime Database sync (Google Cloud, 2024) -->
    <PackageReference Include="FirebaseAdmin" Version="3.1.0" />

    <!-- Azure Blob Storage SDK for cloud PDF report persistence (Microsoft, 2024) -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.23.0" />
  </ItemGroup>

</Project>
