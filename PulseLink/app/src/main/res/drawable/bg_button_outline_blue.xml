<?xml version="1.0" encoding="utf-8"?>
<!--
    Secondary (outlined) button background.
    8dp radius to match bg_button_primary / bg_button_danger, 1.5dp brand stroke,
    soft brand-coloured ripple clipped to the rounded shape.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pulse_ripple_on_light">

    <!-- Content -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pulse_card" />
            <stroke
                android:width="1.5dp"
                android:color="@color/pulse_primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Mask keeps the ripple inside the rounded corners -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</ripple>
