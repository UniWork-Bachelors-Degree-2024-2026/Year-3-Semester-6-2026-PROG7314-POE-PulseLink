<?xml version="1.0" encoding="utf-8"?>
<!-- Row background for list dialogs (Take photo, Choose site, Choose primary doctor ...). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <inset android:insetLeft="20dp" android:insetTop="5dp" android:insetRight="20dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/pulse_blue_bg" />
                <stroke android:width="1.5dp" android:color="@color/pulse_primary" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:insetLeft="20dp" android:insetTop="5dp" android:insetRight="20dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/pulse_blue_bg" />
                <stroke android:width="1dp" android:color="@color/pulse_border_strong" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="20dp" android:insetTop="5dp" android:insetRight="20dp" android:insetBottom="5dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/pulse_input_bg" />
                <stroke android:width="1dp" android:color="@color/pulse_border" />
                <corners android:radius="14dp" />
            </shape>
        </inset>
    </item>
</selector>
