<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined dialog action (Cancel and secondary actions). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="4dp"
    android:insetTop="4dp"
    android:insetRight="4dp"
    android:insetBottom="4dp">
    <ripple android:color="@color/pulse_ripple_on_light">
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/pulse_card" />
                <stroke android:width="1.5dp" android:color="@color/pulse_border_strong" />
                <corners android:radius="14dp" />
            </shape>
        </item>
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@color/white" />
                <corners android:radius="14dp" />
            </shape>
        </item>
    </ripple>
</inset>
