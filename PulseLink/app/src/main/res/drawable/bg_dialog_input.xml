<?xml version="1.0" encoding="utf-8"?>
<!-- Text field inside dialogs: clear brand outline while it has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pulse_input_bg" />
            <stroke android:width="2dp" android:color="@color/pulse_primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pulse_input_bg" />
            <stroke android:width="1dp" android:color="@color/pulse_border_strong" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
