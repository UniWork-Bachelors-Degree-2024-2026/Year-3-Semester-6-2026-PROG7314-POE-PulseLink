<?xml version="1.0" encoding="utf-8"?>
<!--
    Elevated card surface: 12dp radius, #FFFFFF fill, 1dp #E5E7EB stroke.

    A plain shape cannot cast a shadow, so the elevation is drawn as three
    stacked, translucent, rounded layers that are inset less and less towards
    the bottom edge. The result is a soft shadow that works on every API level
    and needs no android:elevation / outline provider on the view.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Ambient shadow (widest, faintest) -->
    <item
        android:left="0dp"
        android:top="1dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A0F172A" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Mid shadow -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#0F0F172A" />
            <corners android:radius="13dp" />
        </shape>
    </item>

    <!-- Contact shadow (tightest, darkest) -->
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#140F172A" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Card surface -->
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pulse_card" />
            <stroke
                android:width="1dp"
                android:color="@color/pulse_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</layer-list>
