<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============ Typography scale ============ -->
    <!-- Medium/SemiBold -->

    <!-- Header: 22sp Bold -->
    <style name="TextAppearance.PulseLink.Header" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Subtitle: 15sp Medium -->
    <style name="TextAppearance.PulseLink.Subtitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Telemetry: 32sp Bold (large numeric readouts - BPM, Lead I, etc.) -->
    <style name="TextAppearance.PulseLink.Telemetry" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Body: 14sp Regular -->
    <style name="TextAppearance.PulseLink.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Button: 15sp SemiBold -->
    <style name="TextAppearance.PulseLink.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ============ Task 20: Icon + label button ============ -->
    <!-- Used with MaterialButton. app:icon is laid out NEXT TO the label and the pair is
         centred inside the button (iconGravity=textStart), so the icon never gets pinned
         to the button border the way a TextView compound drawable does. Colour and shape
         come from android:background (bg_button_primary / _danger / _outline_blue) and the
         icon colour from app:iconTint on each button. -->
    <style name="Widget.PulseLink.Button" parent="Widget.Material3.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">18dp</item>
    </style>

    <!-- ============ Cards: one flat, bordered style for every card in the app ============
         Applied through the materialCardViewStyle theme attribute (see themes.xml), so a card needs
         no per-card elevation or border. A shadow under a border looks smudged, so cards use a
         1dp border and no elevation. A card with a filled colour sets app:strokeWidth="0dp". -->
    <style name="Widget.PulseLink.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/pulse_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/pulse_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ============ Appearance screen: segmented selector (Theme: System / Light / Dark) ============
         Used inside a MaterialButtonToggleGroup. Colours come from the PulseLink tokens through
         res/color/appearance_segment_*.xml, so it follows light, dark and high contrast. -->
    <style name="Widget.PulseLink.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/appearance_segment_bg</item>
        <item name="android:textColor">@color/appearance_segment_text</item>
        <item name="strokeColor">@color/pulse_border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/pulse_ripple_on_light</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconTint">@color/appearance_segment_text</item>
        <item name="iconSize">22dp</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- ============ Date picker (high contrast, follows light / dark mode) ============
         Used by every DatePickerDialog (registration + profile edit). Uses the PulseLink card and text
         tokens plus a strong sky-blue accent (pulse_picker_accent) for the header, the selected day and
         the OK / Cancel buttons, so it stays readable in both light and dark mode. -->
    <style name="ThemeOverlay.PulseLink.DatePicker" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/pulse_picker_accent</item>
        <item name="colorPrimaryDark">@color/pulse_picker_accent</item>
        <item name="colorAccent">@color/pulse_picker_accent</item>
        <item name="colorControlActivated">@color/pulse_picker_accent</item>
        <item name="android:colorAccent">@color/pulse_picker_accent</item>
        <item name="android:colorControlActivated">@color/pulse_picker_accent</item>
        <item name="android:colorBackground">@color/pulse_card</item>
        <item name="android:windowBackground">@color/pulse_card</item>
        <item name="android:textColorPrimary">@color/pulse_text_primary</item>
        <item name="android:textColorSecondary">@color/pulse_text_secondary</item>
        <item name="android:textColorPrimaryInverse">@color/pulse_picker_on_accent</item>
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="android:datePickerStyle">@style/Widget.PulseLink.DatePicker</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.PulseLink.DatePickerButton</item>
    </style>

    <!-- Calendar header, weekday row, day numbers and year list all use explicit high-contrast tokens,
         so nothing depends on the platform default tints (which were hard to read, especially in dark mode). -->
    <style name="Widget.PulseLink.DatePicker" parent="android:Widget.Material.DatePicker">
        <item name="android:headerBackground">@color/pulse_picker_accent</item>
        <item name="android:headerMonthTextAppearance">@style/TextAppearance.PulseLink.DatePickerHeader</item>
        <item name="android:headerDayOfMonthTextAppearance">@style/TextAppearance.PulseLink.DatePickerHeader</item>
        <item name="android:headerYearTextAppearance">@style/TextAppearance.PulseLink.DatePickerHeader</item>
        <item name="android:calendarTextColor">@color/pulse_text_primary</item>
        <item name="android:dayOfWeekTextAppearance">@style/TextAppearance.PulseLink.DatePickerWeekday</item>
        <item name="android:yearListItemTextAppearance">@style/TextAppearance.PulseLink.DatePickerBody</item>
        <item name="android:yearListSelectorColor">@color/pulse_picker_accent</item>
    </style>

    <style name="TextAppearance.PulseLink.DatePickerHeader" parent="android:TextAppearance.Material.Widget.Button">
        <item name="android:textColor">@color/pulse_picker_on_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PulseLink.DatePickerWeekday" parent="android:TextAppearance.Material.Widget.Button">
        <item name="android:textColor">@color/pulse_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.PulseLink.DatePickerBody" parent="android:TextAppearance.Material.Widget.Button">
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.PulseLink.DatePickerButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/pulse_picker_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- ============ PulseLink dialogs (follow light / dark mode) ============
         Rounded card in the app's card colour, brand badge + bold title, rounded option rows and the
         same outlined / filled buttons as the rest of the app. Applied with
         MaterialAlertDialogBuilder(context, R.style.ThemeOverlay_PulseLink_Dialog). -->
    <style name="ShapeAppearance.PulseLink.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="MaterialAlertDialog.PulseLink" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.PulseLink.Dialog</item>
        <item name="backgroundTint">@color/pulse_card</item>
        <item name="listItemLayout">@layout/dialog_option_item</item>
        <item name="multiChoiceItemLayout">@layout/dialog_option_item_multi</item>
        <item name="singleChoiceItemLayout">@layout/dialog_option_item_multi</item>
    </style>

    <style name="MaterialAlertDialog.PulseLink.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/pulse_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawableStart">@drawable/bg_dialog_title_icon</item>
        <item name="android:drawablePadding">12dp</item>
    </style>

    <!-- Filled action: Save, Approve, Confirm -->
    <style name="Widget.PulseLink.DialogButton" parent="Widget.PulseLink.Button">
        <item name="android:background">@drawable/bg_dialog_button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">104dp</item>
    </style>

    <!-- Outlined action: Cancel and secondary actions -->
    <style name="Widget.PulseLink.DialogButton.Outline" parent="Widget.PulseLink.DialogButton">
        <item name="android:background">@drawable/bg_dialog_button_outline</item>
        <item name="android:textColor">@color/pulse_text_primary</item>
    </style>

    <style name="ThemeOverlay.PulseLink.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurfaceContainerHigh">@color/pulse_card</item>
        <item name="alertDialogStyle">@style/MaterialAlertDialog.PulseLink</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.PulseLink.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.PulseLink.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.PulseLink.DialogButton.Outline</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.PulseLink.DialogButton.Outline</item>
        <item name="colorPrimary">@color/pulse_primary</item>
        <item name="colorOnSurface">@color/pulse_text_primary</item>
        <item name="colorSurface">@color/pulse_card</item>
        <item name="colorControlActivated">@color/pulse_primary</item>
        <item name="colorControlNormal">@color/pulse_text_hint</item>
        <item name="android:textColorPrimary">@color/pulse_text_primary</item>
        <item name="android:textColorSecondary">@color/pulse_text_secondary</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
</resources>
