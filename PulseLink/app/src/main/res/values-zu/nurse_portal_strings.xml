    <!-- Imibuzo Yosizo Yesiguli -->
    <string name="patient_faq_q1">Imiphumela yami ye-ECG nokuhlolwa kukadokotela kuzolunga nini?</string>
    <string name="patient_faq_a1">Ngemuva kokuba umhlengikazi eqede ukuqopha i-ECG yakho imizuzwana engu-90, ithunyelwa kudokotela wakho. Ukuze uvikeleke, imiphumela ihlala ilindile kuze kube udokotela uyayiqinisekisa bese eyikhiphela kuwe.</string>
    <string name="patient_faq_q2">Ngiwubona kanjani umuthi kadokotela, uhlelo lokunakekelwa nezeluleko?</string>
    <string name="patient_faq_a2">Uma udokotela esekhiphe imiphumela yakho, vula ithebhu Yemibiko ngezansi bese ucindezela iseshini ukuze ufunde imithi nezeluleko noma ulande umbiko we-PDF.</string>
    <string name="patient_faq_q3">Asho ukuthini amabanga akhonjiswa ekhasini lesimo seseshini?</string>
    <string name="patient_faq_a3">Okulinde Ukubuyekezwa Kudokotela kusho ukuthi ukuqoshwa kwe-ECG kulondoloziwe ukuze udokotela akubuke. Imiphumela Ikhishiwe kusho ukuthi udokotela useqinisekise imiphumela yakho.</string>
    <string name="patient_faq_q4">Ngiyithola kanjani iklinikhi noma isibhedlela esiseduze e-Gqeberha?</string>
    <string name="patient_faq_a4">Vula ithebhu ye-SOS ngezansi bese ucindezela i-Facility Finder &amp; Maps ukuze usondeze ibalazwe futhi uvule izikhombisi-ndlela ku-Google Maps.</string>
    <string name="patient_faq_q5">Ngithumela kanjani umlayezo kumhlengikazi ngengxoxo ebukhoma?</string>
    <string name="patient_faq_a5">Cindezela i-Live Chat noma i-Contact Support phezulu kuleli khasi ukuze uxoxe nomhlengikazi weklinikhi ngesikhathi sangempela.</string>
    <string name="patient_faq_q6">Kufanele ngenzeni esimweni esiphuthumayo sezempilo (SOS)?</string>
    <string name="patient_faq_a6">I-PulseLink ayithumeli ama-ambulensi ngokuzenzakalelayo. Uma uzwa ubuhlungu esifubeni noma usenkingeni ephuthumayo, cindezela ithebhu ye-SOS ngokushesha ukuze ushayele u-112 noma u-10177.</string>
    <string name="patient_faq_q7">Ivikelwa kanjani idatha yami yezempilo?</string>
    <string name="patient_faq_a7">Iphrofayili yakho nemibiko ivikelwe nge-Firebase Authentication, ukukhiya kwezigxivizo zeminwe, ukuxhumana okubethelwe nge-HTTPS kanye nokulawula ukufinyelela okusekelwe endimeni.</string>
    <string name="patient_faq_search_empty">Azikho izihloko zosizo ezitholiwe. Zama elinye igama noma uvule i-Live Chat.</string>
    <string name="patient_faq_user_guide_title">Umhlahlandlela Weseshini Neklinikhi</string>
    <string name="patient_faq_user_guide_subtitle">Hlola isimo sakho sakamuva se-ECG noma thola iklinikhi</string>

