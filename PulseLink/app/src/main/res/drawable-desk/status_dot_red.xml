<?xml version="1.0" encoding="utf-8"?>
<!--
    Colour-blind friendly version of the red status dot: a DIAMOND, so "Critical" can be told apart
    from the circle (normal) and the triangle (warning) without relying on colour.
    Used automatically when Settings > Appearance > Colour-blind friendly is on.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="10dp"
    android:height="10dp"
    android:viewportWidth="10"
    android:viewportHeight="10">
    <path
        android:fillColor="@color/pulse_danger"
        android:pathData="M5,0L10,5L5,10L0,5z" />
</vector>
