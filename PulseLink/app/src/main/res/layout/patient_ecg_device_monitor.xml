<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:orientation="vertical"
    tools:context=".EcgDeviceMonitorActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/patient_ecg_device_monitor_text_ecg_device_monitor"
            android:accessibilityHeading="true"
            android:textColor="@color/pulse_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Device summary card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pulse_primary_fill"
                app:strokeWidth="0dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_white"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_heart_pulse" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDeviceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_ecg_device_monitor_text_pulselink_pro_monitor"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDeviceSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_ecg_device_monitor_text_ad8232_sensor_array"
                                android:textColor="@color/pulse_primary_light"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layoutDeviceStatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_white"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp">

                            <ImageView
                                android:id="@+id/ivDeviceStatusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:contentDescription="@null"
                                android:src="@drawable/circle_success_bg" />

                            <TextView
                                android:id="@+id/tvDeviceStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/patient_ecg_device_monitor_text_connected"
                                android:textColor="@color/pulse_success"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_bolt"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/tvDevicePowerSource"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/l10n_power_5v_usb"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/l10n_continuous"
                                android:textColor="@color/pulse_primary_light"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wifi" />

                            <TextView
                                android:id="@+id/tvDeviceSignal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/patient_ecg_device_monitor_text_excellent"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_ecg_device_monitor_text_signal"
                                android:textColor="@color/pulse_primary_light"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_electrode" />

                            <TextView
                                android:id="@+id/tvLeadConfig"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/patient_ecg_device_monitor_text_lead_i"
                                android:textColor="@color/white"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_ecg_device_monitor_text_lead_config"
                                android:textColor="@color/pulse_primary_light"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Live preview -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/patient_ecg_device_monitor_text_live_preview"
                android:textColor="@color/pulse_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_ecg_device_monitor_text_waveform_monitor"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="@string/patient_ecg_device_monitor_text_72_bpm"
                            android:textColor="@color/pulse_ecg_red"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp">

                        <com.example.prog7314_poepart23.views.HospitalPaperEcgView
                            android:id="@+id/hospitalPaperEcgView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Device information -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/patient_ecg_device_monitor_text_device_information"
                android:textColor="@color/pulse_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_ecg_device_monitor_text_mac_address"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDeviceMac"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="@string/patient_ecg_device_monitor_text_80_1a_2b_3c"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_ecg_device_monitor_text_firmware"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDeviceFirmware"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/nurse_ui_firmware_esp32"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_ecg_device_monitor_text_sampling_rate"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDeviceSamplingRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/patient_ecg_device_monitor_text_250hz"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_ecg_device_monitor_text_last_sync"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDeviceLastSync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/patient_ecg_device_monitor_text_just_now"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForceSync"
                    style="@style/Widget.PulseLink.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="@string/patient_ecg_device_monitor_text_force_sync"
                    android:textColor="@color/pulse_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pulse_card"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_sync"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/pulse_primary"
                    app:rippleColor="@color/pulse_ripple_on_light"
                    app:strokeColor="@color/pulse_primary"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalibrate"
                    style="@style/Widget.PulseLink.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:singleLine="true"
                    android:text="@string/patient_ecg_device_monitor_text_calibrate"
                    android:textColor="@color/pulse_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pulse_card"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="24dp"
                    app:iconTint="@color/pulse_text_secondary"
                    app:rippleColor="@color/pulse_ripple_on_light"
                    app:strokeColor="@color/pulse_primary"
                    app:strokeWidth="1.5dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForgetDevice"
                style="@style/Widget.PulseLink.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:singleLine="true"
                android:text="@string/patient_ecg_device_monitor_text_forget_device"
                android:textColor="@color/pulse_danger"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pulse_danger_bg"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="24dp"
                app:iconTint="@color/pulse_danger" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav_nurse" />

</LinearLayout>