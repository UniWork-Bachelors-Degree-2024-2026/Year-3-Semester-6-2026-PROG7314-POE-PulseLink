<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:orientation="vertical"
    tools:context=".SessionReportPreviewActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/ivClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/patient_session_report_preview_text_session_report_preview"
            android:accessibilityHeading="true"
            android:textColor="@color/pulse_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ivShare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_share"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share"
            />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Report header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_session_report_preview_text_pulselink_rpm"
                                android:textColor="@color/pulse_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/patient_session_report_preview_text_clinical_ecg_report"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_session_report_preview_text_report_id"
                                android:textColor="@color/pulse_text_hint"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvReportId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="@string/patient_session_report_preview_text_ml_2023_8942a"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/pulse_divider" />

                    <!-- Patient row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/circle_blue_bg"
                            android:contentDescription="@null"
                            android:padding="10dp"
                            android:src="@drawable/ic_person" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPatientName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="@string/patient_session_report_preview_text_robert_robertson"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvPatientDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                tools:text="@string/patient_session_report_preview_text_id_mrn_84729_dob"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_session_report_preview_text_heart_rate"
                                android:textColor="@color/pulse_text_hint"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvHeartRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="@string/patient_session_report_preview_text_72_bpm"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Clinical summary -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/patient_session_report_preview_text_clinical_summary"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/patient_session_report_preview_text_analysis"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvClinicalAnalysis"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_success"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:text="@string/ui_review_required"
                                android:textColor="@color/pulse_success"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:background="@color/pulse_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/patient_session_report_preview_text_avg_hr"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvAvgHeartRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="@string/patient_session_report_preview_text_72_bpm_2"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/patient_session_report_preview_text_duration"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="@string/patient_session_report_preview_text_05_42"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Lead I waveform header with interactive controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/patient_session_report_preview_text_lead_i_waveform"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <!-- Interactive zoom and enlarge controls -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/btnZoomOut"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/ui_zoom_out"
                                android:padding="3dp"
                                android:src="@drawable/ic_zoom_out"
                                app:tint="@color/pulse_text_secondary" />

                            <ImageView
                                android:id="@+id/btnZoomIn"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/ui_zoom_in"
                                android:padding="3dp"
                                android:src="@drawable/ic_zoom_in"
                                app:tint="@color/pulse_text_secondary" />

                            <ImageView
                                android:id="@+id/btnToggleEnlarge"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="6dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/ui_full_screen"
                                android:padding="3dp"
                                android:src="@drawable/ic_fullscreen"
                                app:tint="@color/pulse_text_secondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <HorizontalScrollView
                            android:id="@+id/scrollEcgWaveform"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="horizontal">
                            <com.example.prog7314_poepart23.views.HospitalPaperEcgView android:id="@+id/waveformHospitalPaper" android:layout_width="wrap_content" android:layout_height="match_parent" />
                        </HorizontalScrollView>
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_trace_help"
                            android:textColor="@color/pulse_text_hint"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/patient_session_report_preview_text_clinical_review_only"
                            android:textColor="@color/pulse_text_hint"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendToDoctor"
                    style="@style/Widget.PulseLink.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:paddingStart="18dp"
                    android:paddingEnd="6dp"
                    android:background="@drawable/bg_button_outline_blue"
                    android:text="@string/patient_session_report_preview_text_send_doctor"
                    android:textColor="@color/pulse_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_send"
                    app:iconSize="16dp"
                    app:iconTint="@color/pulse_primary"
                    app:rippleColor="@color/pulse_primary_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadPdf"
                    style="@style/Widget.PulseLink.Button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="6dp"
                    android:background="@drawable/bg_card_blue"
                    android:text="@string/patient_session_report_preview_text_download_pdf"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"
                    app:icon="@drawable/ic_download"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    app:rippleColor="@color/pulse_primary_light" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
