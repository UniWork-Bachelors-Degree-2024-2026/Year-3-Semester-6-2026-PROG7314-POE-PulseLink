<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:orientation="vertical"
    tools:context=".LiveSupportChatActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/support_chat_title_patient"
                android:textColor="@color/pulse_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/support_chat_subtitle_patient"
                android:textColor="@color/pulse_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchChatThread"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/support_chat_switch_thread"
            android:textAllCaps="false"
            android:textColor="@color/pulse_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:cornerRadius="8dp"
            app:strokeColor="@color/pulse_border_strong" />

        <ImageButton
            android:id="@+id/btnChatEmergencyCall"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_danger_bg"
            android:contentDescription="@string/cd_call"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone"
            app:tint="@color/pulse_danger" />
    </LinearLayout>

    <!-- Clinical non-emergency warning -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_pill_warning"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_warning_triangle"
            app:tint="@color/pulse_warning" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/support_chat_banner_warning"
            android:textColor="@color/pulse_text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Message stream -->
    <ScrollView
        android:id="@+id/scrollChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvChatEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/support_chat_empty"
                android:textColor="@color/pulse_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutChatMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Nurse quick replies -->
    <HorizontalScrollView
        android:id="@+id/scrollNurseQuickReplies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickReply1"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/support_chat_quick_1"
                android:textAllCaps="false"
                android:textColor="@color/pulse_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/pulse_card"
                app:cornerRadius="16dp"
                app:strokeColor="@color/pulse_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickReply2"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/support_chat_quick_2"
                android:textAllCaps="false"
                android:textColor="@color/pulse_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/pulse_card"
                app:cornerRadius="16dp"
                app:strokeColor="@color/pulse_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickReply3"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/support_chat_quick_3"
                android:textAllCaps="false"
                android:textColor="@color/pulse_primary"
                android:textSize="11sp"
                app:backgroundTint="@color/pulse_card"
                app:cornerRadius="16dp"
                app:strokeColor="@color/pulse_border" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Message composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="@string/support_chat_input_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:minHeight="44dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/pulse_text_primary"
            android:textColorHint="@color/pulse_text_hint"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/circle_primary"
            android:contentDescription="@string/support_chat_send"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_send"
            app:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/containerNurseChatBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <include layout="@layout/layout_bottom_nav_nurse" />
    </LinearLayout>

</LinearLayout>
