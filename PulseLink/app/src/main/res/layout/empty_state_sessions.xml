<?xml version="1.0" encoding="utf-8"?>
<!--
    Dedicated empty-state placeholder for the ECG session history list.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/emptyStateSessions"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_xl"
    android:visibility="gone"
    tools:ignore="UselessParent">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/circle_blue_bg">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_heart_pulse"
            app:tint="@color/clinical_blue" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvEmptySessionsMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:gravity="center"
        android:text="@string/empty_state_sessions_message"
        android:textAppearance="@style/TextAppearance.PulseLink.Body"
        android:textColor="@color/text_secondary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEmptySessionsStartRecording"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:backgroundTint="@color/clinical_blue"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:text="@string/empty_state_sessions_btn_start_recording"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.PulseLink.Button"
        android:textColor="@color/white"
        app:cornerRadius="@dimen/corner_radius_md"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconTint="@color/white" />

</LinearLayout>
