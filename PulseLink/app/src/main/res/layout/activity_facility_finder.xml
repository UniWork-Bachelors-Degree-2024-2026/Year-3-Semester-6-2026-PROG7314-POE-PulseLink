<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg">

    <!-- Map Canvas (Default View) -->
    <FrameLayout
        android:id="@+id/layoutMapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.example.prog7314_poepart23.views.GqeberhaMapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Map Zoom Controls (+ / - / Reset) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardZoomControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="316dp"
            app:cardBackgroundColor="@color/pulse_card"
            app:cardCornerRadius="22dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/pulse_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnZoomIn"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/facility_zoom_in"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_zoom_in"
                    app:tint="@color/pulse_text_primary" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@color/pulse_divider" />

                <ImageButton
                    android:id="@+id/btnZoomOut"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/facility_zoom_out"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_zoom_out"
                    app:tint="@color/pulse_text_primary" />

                <View
                    android:layout_width="28dp"
                    android:layout_height="1dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@color/pulse_divider" />

                <ImageButton
                    android:id="@+id/btnZoomReset"
                    android:layout_width="44dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/facility_zoom_reset"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_fullscreen"
                    app:tint="@color/pulse_text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Alternative Full List View (Hidden by default, toggled via btnToggleView) -->
    <LinearLayout
        android:id="@+id/layoutListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="120dp"
        android:orientation="vertical"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFacilityList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:padding="16dp"
            android:paddingBottom="48dp" />

        <!-- Empty search state -->
        <LinearLayout
            android:id="@+id/layoutEmptySearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="@color/pulse_text_hint" />

            <TextView
                android:id="@+id/tvEmptySearchMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/facility_empty_search"
                android:textColor="@color/pulse_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top floating controls overlay: Search bar + Filter chips -->
    <LinearLayout
        android:id="@+id/layoutTopOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- Offline notice banner if offline -->
        <TextView
            android:id="@+id/tvOfflineNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_pill_warning"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/facility_offline_notice"
            android:textColor="@color/pulse_warning"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Google Maps-style floating Search Bar card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSearchBar"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/pulse_card"
            app:cardCornerRadius="25dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/pulse_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_back"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/pulse_primary" />

                <EditText
                    android:id="@+id/etSearchQuery"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/facility_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/pulse_text_primary"
                    android:textColorHint="@color/pulse_text_hint"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cancel"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/pulse_text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Google Maps-style horizontal filter chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/facility_filter_all"
                    android:textColor="@color/selector_facility_chip_text"
                    android:textSize="12sp"
                    app:checkedIconTint="@color/white"
                    app:chipBackgroundColor="@color/selector_facility_chip_bg"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/pulse_border_strong"
                    app:chipStrokeWidth="1dp"
                    app:chipSurfaceColor="@android:color/transparent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterHospitals"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/facility_filter_hospitals"
                    android:textColor="@color/selector_facility_chip_text"
                    android:textSize="12sp"
                    app:checkedIconTint="@color/white"
                    app:chipBackgroundColor="@color/selector_facility_chip_bg"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/pulse_border_strong"
                    app:chipStrokeWidth="1dp"
                    app:chipSurfaceColor="@android:color/transparent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterClinics"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/facility_filter_clinics"
                    android:textColor="@color/selector_facility_chip_text"
                    android:textSize="12sp"
                    app:checkedIconTint="@color/white"
                    app:chipBackgroundColor="@color/selector_facility_chip_bg"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/pulse_border_strong"
                    app:chipStrokeWidth="1dp"
                    app:chipSurfaceColor="@android:color/transparent" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFilterChc"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/facility_filter_chc"
                    android:textColor="@color/selector_facility_chip_text"
                    android:textSize="12sp"
                    app:checkedIconTint="@color/white"
                    app:chipBackgroundColor="@color/selector_facility_chip_bg"
                    app:chipCornerRadius="16dp"
                    app:chipStrokeColor="@color/pulse_border_strong"
                    app:chipStrokeWidth="1dp"
                    app:chipSurfaceColor="@android:color/transparent" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Floating view list / map toggle button (kept outside containers so both modes stay switchable) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnToggleView"
        style="@style/Widget.PulseLink.Button"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="260dp"
        android:text="@string/facility_toggle_list"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@color/pulse_primary_fill"
        app:cornerRadius="22dp"
        app:elevation="6dp"
        app:icon="@drawable/ic_list_bullet"
        app:iconSize="16dp"
        app:iconTint="@color/white" />

    <!-- Bottom Place Peek Card (Google Maps style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPlacePeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/pulse_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="@color/pulse_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:id="@+id/layoutPlacePeekContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <!-- Handle pill indicator -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_pill_neutral" />

            <!-- Title & Type Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlaceName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Livingstone Tertiary Hospital"
                    android:textColor="@color/pulse_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlaceTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_pill_info"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    tools:text="Tertiary Hospital"
                    android:textColor="@color/pulse_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPlaceArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Korsten, Gqeberha"
                android:textColor="@color/pulse_text_secondary"
                android:textSize="12sp" />

            <!-- Address row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_map_pin"
                    app:tint="@color/pulse_primary" />

                <TextView
                    android:id="@+id/tvPlaceAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    tools:text="Stanford Road, Korsten, Gqeberha, 6020"
                    android:textColor="@color/pulse_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Coordinates & review date row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlaceCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="-33.925240, 25.569760"
                    android:textColor="@color/pulse_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPlaceReviewedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_pill_neutral"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    tools:text="Reviewed: 2026-11-06"
                    android:textColor="@color/pulse_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Source text -->
            <TextView
                android:id="@+id/tvPlaceSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Source: Eastern Cape Department of Health"
                android:textColor="@color/pulse_text_hint"
                android:textSize="10sp" />

            <!-- Action buttons: Directions & Copy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenDirections"
                    style="@style/Widget.PulseLink.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/facility_directions_action"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/pulse_primary_fill"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_directions"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyCoordinates"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/facility_copy_coords"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:cornerRadius="24dp"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/pulse_primary"
                    app:strokeColor="@color/pulse_border_strong" />
            </LinearLayout>

            <!-- Honesty clinical disclaimer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/facility_disclaimer_short"
                android:textColor="@color/pulse_text_hint"
                android:textSize="10sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
