<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/circle_blue_bg"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_bell" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pulse_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Session report ready" />

        <TextView
            android:id="@+id/tvMessagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/pulse_text_secondary"
            android:textSize="12sp"
            tools:text="Your ECG session from this morning has been reviewed by Dr. Connor." />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/pulse_text_hint"
            android:textSize="10sp"
            tools:text="10:42 AM" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:contentDescription="@null"
        android:src="@drawable/circle_blue_bg" />
</LinearLayout>