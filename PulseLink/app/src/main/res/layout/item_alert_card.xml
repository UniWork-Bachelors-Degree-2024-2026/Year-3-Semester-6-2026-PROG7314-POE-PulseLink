<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAlertCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_card_left_red"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSeverityIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/circle_danger_bg"
            android:contentDescription="@null"
            android:padding="6dp"
            android:src="@drawable/ic_heart_pulse" />

        <TextView
            android:id="@+id/chipSeverity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_danger"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/pulse_danger"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="CRITICAL" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/pulse_text_hint"
            android:textSize="11sp"
            tools:text="10:42 AM" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAlertType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/pulse_text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Tachycardia detected" />

    <TextView
        android:id="@+id/tvPatientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textColor="@color/pulse_text_secondary"
        android:textSize="11sp"
        tools:text="Eleanor Rigby - ID: MRN-88421" />
</LinearLayout>
