<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:orientation="vertical"
    tools:context=".DeviceManagementActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/patient_device_management_text_pulselink_rpm"
            android:textColor="@color/pulse_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/patient_device_management_text_device_management"
                android:accessibilityHeading="true"
                android:textColor="@color/pulse_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/patient_device_management_text_configure_monitor_connected_rpm"
                android:textColor="@color/pulse_text_secondary"
                android:textSize="13sp" />

            <!-- Offline Warning Banner -->
            <LinearLayout
                android:id="@+id/layoutDeviceOfflineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_danger"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning_triangle"
                    app:tint="@color/pulse_danger" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/patient_device_management_text_offline"
                    android:textColor="@color/pulse_danger"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- No Device Paired Empty State Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardNoDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/pulse_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/patient_device_management_text_no_ecg_monitor_paired"
                        android:accessibilityHeading="true"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/patient_device_management_text_pair_with_account"
                        android:textColor="@color/pulse_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pulse Pro Monitor card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrimaryDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:background="@color/pulse_primary_fill" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/circle_blue_bg"
                                android:contentDescription="@null"
                                android:padding="9dp"
                                android:src="@drawable/ic_heart_pulse" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDeviceName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_device_management_text_pulselink_pro_monitor"
                                    android:textColor="@color/pulse_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDeviceSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_device_management_text_primary_ad8232_sensor_array"
                                    android:textColor="@color/pulse_text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvDeviceConnectionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_success"
                                android:paddingStart="10dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="4dp"
                                android:text="@string/patient_device_management_text_connected"
                                android:textColor="@color/pulse_success"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_device_management_text_battery"
                                    android:textColor="@color/pulse_text_secondary"
                                    android:textSize="12sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_bolt"
                        app:tint="@color/pulse_text_primary" />

                                    <TextView
                                        android:id="@+id/tvDevicePowerSource"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="5dp"
                                        android:text="@string/l10n_usb_powered"
                                        android:textColor="@color/pulse_text_primary"
                                        android:textSize="14sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/patient_device_management_text_signal_strength"
                                    android:textColor="@color/pulse_text_secondary"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDeviceSignalQuality"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/patient_device_management_text_excellent"
                                    android:textColor="@color/pulse_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="@color/pulse_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/patient_device_management_text_last_sync"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="13sp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_sync" />

                            <TextView
                                android:id="@+id/tvDeviceLastSync"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@string/patient_device_management_text_just_now"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/patient_device_management_text_mac_address"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDeviceMac"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="@string/patient_device_management_text_80_1a_2b_3c"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/patient_device_management_text_firmware"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvDeviceFirmware"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/nurse_ui_firmware_esp32"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnForceSync"
                                style="@style/Widget.PulseLink.Button"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:singleLine="true"
                                android:text="@string/patient_device_management_text_force_sync"
                                android:textColor="@color/pulse_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/pulse_card"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_sync"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconSize="18dp"
                                app:iconTint="@color/pulse_primary"
                                app:rippleColor="@color/pulse_ripple_on_light"
                                app:strokeColor="@color/pulse_primary"
                                app:strokeWidth="1.5dp" />

                            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfigureDevice"
                                style="@style/Widget.PulseLink.Button"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:singleLine="true"
                                android:text="@string/patient_device_management_text_configure"
                                android:textColor="@color/pulse_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/pulse_card"
                                app:cornerRadius="8dp"
                                app:icon="@drawable/ic_settings"
                                app:iconGravity="textStart"
                                app:iconPadding="8dp"
                                app:iconSize="24dp"
                                app:iconTint="@color/pulse_text_secondary"
                                app:rippleColor="@color/pulse_ripple_on_light"
                                app:strokeColor="@color/pulse_primary"
                                app:strokeWidth="1.5dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pair new device -->
            <LinearLayout
                android:id="@+id/btnPairNewDevice"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_button_outline_blue"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="22dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_primary"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_add" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/nurse_ui_btn_pair_hardware_cta"
                    android:textColor="@color/pulse_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/patient_device_management_text_connect_new_sensor_or"
                    android:textColor="@color/pulse_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Device support -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/patient_device_management_text_device_support"
                android:textColor="@color/pulse_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowUserManual"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_book" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/patient_device_management_text_user_manual"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/pulse_divider" />

                    <LinearLayout
                        android:id="@+id/rowTroubleshooting"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_wrench" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/patient_device_management_text_troubleshooting"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav_nurse" />

</LinearLayout>