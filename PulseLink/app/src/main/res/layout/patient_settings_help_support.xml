<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:orientation="vertical"
    tools:context=".HelpSupportActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/patient_settings_help_support_text_help_amp_support"
            android:accessibilityHeading="true"
            android:textColor="@color/pulse_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/patient_settings_help_support_text_how_can_we_help"
                android:accessibilityHeading="true"
                android:textColor="@color/pulse_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etSearchHelp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/patient_settings_help_support_hint_search_help_articles"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/pulse_text_primary"
                    android:textColorHint="@color/pulse_text_hint"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Quick contact row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnLiveChat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_stroke"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chat" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/patient_settings_help_support_text_live_chat"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCallUs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_stroke"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/patient_settings_help_support_text_call_us"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnEmailUs"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_stroke"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_mail" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/patient_settings_help_support_text_email"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- FAQ topics -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/patient_settings_help_support_text_frequently_asked_questions"
                android:textColor="@color/pulse_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFaqContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHelpSearchEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="20dp"
                        android:text="@string/patient_faq_search_empty"
                        android:textColor="@color/pulse_text_secondary"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- FAQ 1 -->
                    <LinearLayout
                        android:id="@+id/faqContainer1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/faqElectrodePlacement"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivFaqIcon1"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_blue_bg"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_electrode" />

                            <TextView
                                android:id="@+id/tvFaqQuestion1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/patient_settings_help_support_text_electrode_placement"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/faqElectrodePlacementAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="62dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/tvFaqAnswer1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/patient_settings_help_support_text_electrode_placement_answer"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="12sp"
                                android:lineSpacingExtra="3dp" />

                            <TextView
                                android:id="@+id/btnViewPlacementGuide"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:padding="4dp"
                                android:text="@string/patient_settings_help_support_text_view_placement_guide"
                                android:textColor="@color/pulse_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:id="@+id/faqDivider1"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/pulse_divider" />

                    <!-- FAQ 2 -->
                    <LinearLayout
                        android:id="@+id/faqContainer2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/faqPairing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivFaqIcon2"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_blue_bg"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_bluetooth" />

                            <TextView
                                android:id="@+id/tvFaqQuestion2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/patient_settings_help_support_text_how_do_i_pair"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/faqPairingAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="62dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:text="@string/patient_settings_help_support_text_how_do_i_pair_answer"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/faqDivider2"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/pulse_divider" />

                    <!-- FAQ 3 -->
                    <LinearLayout
                        android:id="@+id/faqContainer3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/faqIrregularRhythm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivFaqIcon3"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_success_bg"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_heart_pulse" />

                            <TextView
                                android:id="@+id/tvFaqQuestion3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/patient_settings_help_support_text_what_does_irregular_rhythm"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/faqIrregularRhythmAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="62dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:text="@string/patient_settings_help_support_text_what_does_irregular_rhythm_answer"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/faqDivider3"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/pulse_divider" />

                    <!-- FAQ 4 -->
                    <LinearLayout
                        android:id="@+id/faqContainer4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/faqSyncing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivFaqIcon4"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_warning_bg"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_cloud_off" />

                            <TextView
                                android:id="@+id/tvFaqQuestion4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/patient_settings_help_support_text_why_isn_t_my"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/faqSyncingAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="62dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:text="@string/patient_settings_help_support_text_why_isn_t_my_answer"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/faqDivider4"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/pulse_divider" />

                    <!-- FAQ 5 -->
                    <LinearLayout
                        android:id="@+id/faqContainer5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/faqBattery"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivFaqIcon5"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_success_bg"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_battery" />

                            <TextView
                                android:id="@+id/tvFaqQuestion5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/patient_settings_help_support_text_battery_life"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/faqBatteryAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="62dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:text="@string/patient_settings_help_support_text_battery_life_answer"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/faqDivider5"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/pulse_divider" />

                    <!-- FAQ 6 -->
                    <LinearLayout
                        android:id="@+id/faqContainer6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/faqConnectivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivFaqIcon6"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_blue_bg"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_wifi" />

                            <TextView
                                android:id="@+id/tvFaqQuestion6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/patient_settings_help_support_text_connectivity"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/faqConnectivityAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="62dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:text="@string/patient_settings_help_support_text_connectivity_answer"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <View
                        android:id="@+id/faqDivider6"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/pulse_divider" />

                    <!-- FAQ 7 -->
                    <LinearLayout
                        android:id="@+id/faqContainer7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/faqDataPrivacy"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:id="@+id/ivFaqIcon7"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/circle_danger_bg"
                                android:contentDescription="@null"
                                android:padding="8dp"
                                android:src="@drawable/ic_shield" />

                            <TextView
                                android:id="@+id/tvFaqQuestion7"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/patient_settings_help_support_text_how_my_health_data"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/faqDataPrivacyAnswer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="62dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="16dp"
                            android:text="@string/patient_settings_help_support_text_how_my_health_data_answer"
                            android:textColor="@color/pulse_text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="3dp"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ====================================================== -->
            <!-- ACTION BUTTONS BELOW FAQ -->
            <!-- ====================================================== -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/patient_settings_help_support_text_need_more_help"
                android:textColor="@color/pulse_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Contact Support -->
            <LinearLayout
                android:id="@+id/btnContactSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_stroke"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_settings_help_support_text_contact_support"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/patient_settings_help_support_text_get_help"
                        android:textColor="@color/pulse_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- User Guide -->
            <LinearLayout
                android:id="@+id/btnUserGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_stroke"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_book" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserGuideTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_settings_help_support_text_user_guide"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserGuideSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/patient_settings_help_support_text_learn_pulselink"
                        android:textColor="@color/pulse_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Report Problem -->
            <LinearLayout
                android:id="@+id/btnReportProblem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_stroke"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning_triangle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patient_settings_help_support_text_report_problem"
                        android:textColor="@color/pulse_text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/patient_settings_help_support_text_issue_app_device"
                        android:textColor="@color/pulse_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Emergency note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_danger_light"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning_triangle" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/patient_settings_help_support_text_this_help_center_not"
                    android:textColor="@color/pulse_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>