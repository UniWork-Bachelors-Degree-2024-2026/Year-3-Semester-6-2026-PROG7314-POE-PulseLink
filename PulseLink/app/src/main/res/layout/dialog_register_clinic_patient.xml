<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/pulse_card"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/circle_blue_bg">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_person"
                app:tint="@color/pulse_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/nurse_ui_modal_reg_title"
            android:textColor="@color/pulse_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/nurse_ui_modal_reg_desc"
            android:textColor="@color/pulse_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_person"
                app:tint="@color/pulse_text_secondary" />

            <EditText
                android:id="@+id/etDialogPatientFullName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/nurse_ui_modal_patient_name_hint"
                android:inputType="textPersonName|textCapWords"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="0dp"
                android:paddingBottom="12dp"
                android:textColor="@color/pulse_text_primary"
                android:textColorHint="@color/pulse_text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDialogPatientDob"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar_small"
                app:tint="@color/pulse_text_secondary" />

            <EditText
                android:id="@+id/etDialogPatientDob"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/nurse_ui_modal_patient_dob_hint"
                android:inputType="date"
                android:maxLength="10"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp"
                android:textColor="@color/pulse_text_primary"
                android:textColorHint="@color/pulse_text_hint"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btnPickDobCalendar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circle_blue_bg"
                android:contentDescription="@string/nurse_ui_modal_patient_dob_hint"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendar_small"
                app:tint="@color/pulse_picker_accent" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/nurse_ui_modal_doctor_label"
            android:textColor="@color/pulse_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rowDialogDoctorSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_input_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stethoscope"
                app:tint="@color/pulse_text_secondary" />

            <TextView
                android:id="@+id/tvSelectedAttendingDoctor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/pulse_text_primary"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/pulse_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowDialogCustomDoctorUid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stethoscope"
                app:tint="@color/pulse_text_secondary" />

            <EditText
                android:id="@+id/etDialogCustomDoctorUid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/nurse_ui_modal_doctor_uid_hint"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="12dp"
                android:paddingEnd="0dp"
                android:paddingBottom="12dp"
                android:textColor="@color/pulse_text_primary"
                android:textColorHint="@color/pulse_text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRegisterPatientDialog"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/pulse_bg"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/pulse_text_secondary"
                android:textSize="14sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmRegisterPatientDialog"
                style="@style/Widget.PulseLink.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.3"
                android:backgroundTint="@color/pulse_primary_fill"
                android:text="@string/nurse_ui_modal_reg_submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
