<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_bg"
    android:orientation="vertical"
    tools:context=".DevicePairingActivity">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left"
            />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/patient_device_pairing_text_device_pairing"
            android:accessibilityHeading="true"
            android:textColor="@color/pulse_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/circle_blue_bg">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wifi" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/patient_device_pairing_text_scanning_devices"
                android:accessibilityHeading="true"
                android:textColor="@color/pulse_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/patient_device_pairing_text_make_sure_pulselink_monitor"
                android:textColor="@color/pulse_text_secondary"
                android:textSize="13sp" />

            <!-- 2.4 GHz Wi-Fi Provisioning Guide Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_bolt"
                            app:tint="@color/pulse_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/l10n_pairing_guide_title"
                            android:textColor="@color/pulse_text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/l10n_pairing_guide_steps"
                        android:textColor="@color/pulse_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Scanning / Empty State -->
            <LinearLayout
                android:id="@+id/layoutScanningState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card_stroke"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_blue_bg"
                    android:contentDescription="@null"
                    android:padding="12dp"
                    android:src="@drawable/ic_monitor" />

                <TextView
                    android:id="@+id/tvScanStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/l10n_ready_to_scan"
                    android:textColor="@color/pulse_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScanStateSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/l10n_ready_to_scan_desc"
                    android:textColor="@color/pulse_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Dynamic Discovered Device Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDiscoveredDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/pulse_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_blue_bg"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_heart_pulse" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDiscoveredDeviceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/l10n_default_monitor_name"
                                android:textColor="@color/pulse_text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDiscoveredDeviceSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:text="@string/l10n_monitor_spec"
                                android:textColor="@color/pulse_text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_signal_strength" />
                    </LinearLayout>

                    <!-- Ping Status Readout -->
                    <TextView
                        android:id="@+id/tvDiscoveredPingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_pill_neutral"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/l10n_ready_to_connect"
                        android:textColor="@color/pulse_text_secondary"
                        android:textSize="11sp" />

                    <!-- Action Buttons: Ping & Pair -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPingDiscoveredDevice"
                            style="@style/Widget.PulseLink.Button"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_outline_blue"
                            android:text="@string/l10n_ping_esp32"
                            android:textColor="@color/pulse_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_sync"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/pulse_primary"
                            app:rippleColor="@color/pulse_primary_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPairDiscoveredDevice"
                            style="@style/Widget.PulseLink.Button"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_blue"
                            android:text="@string/l10n_pair_device"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_check_circle"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/white"
                            app:rippleColor="@color/pulse_primary_light" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenPairHardwareModal"
                style="@style/Widget.PulseLink.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/nurse_ui_btn_pair_hardware_cta"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/pulse_primary_fill"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanAgain"
                style="@style/Widget.PulseLink.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_outline_blue"
                android:text="@string/patient_device_pairing_text_scan_again"
                android:textColor="@color/pulse_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:rippleColor="@color/pulse_primary_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/patient_device_pairing_text_having_trouble_pairing"
                android:textColor="@color/pulse_text_hint"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
